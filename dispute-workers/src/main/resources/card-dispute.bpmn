    <bpmn:sequenceFlow id="Flow_1cw6ick" sourceRef="review-dispute" targetRef="Gateway_AnalystDecision" />
    <bpmn:sequenceFlow id="Flow_1sh44ys" name="Initiate" sourceRef="Gateway_AnalystDecision" targetRef="Activity_08uwf6r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=analystDecision = "INITIATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0e4eh3x" name="Don&#39;t Initiate" sourceRef="Gateway_AnalystDecision" targetRef="Activity_1cxv9da" />
    <bpmn:endEvent id="Event_0k0ua3a" name="No chargeback">
