    <bpmn:sequenceFlow id="Flow_0i3kxf6" sourceRef="Activity_0o36kht" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_0iiv8ly" name="Manual review" sourceRef="Gateway_Route" targetRef="review-dispute" />
    <bpmn:userTask id="review-dispute" name="Review dispute">
