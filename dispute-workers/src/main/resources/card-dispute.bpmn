    <bpmn:sequenceFlow id="Flow_0qkxpeh" name="Auto-approve" sourceRef="Gateway_Route" targetRef="Activity_08uwf6r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=route = "AUTO_APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_19ne8uw" name="Chargeback initiated">
      <bpmn:incoming>Flow_1s1xwem</bpmn:incoming>
